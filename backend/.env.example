# Copy this file to backend/.env and fill in your key. Never commit .env.

# One OpenRouter key powers both the LLM and Jev (TypeSafe Decisions API).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM models (check https://openrouter.ai/models for exact slugs)
LLM_PLANNER_MODEL=anthropic/claude-sonnet-4.5
LLM_FAST_MODEL=google/gemini-2.5-flash
LLM_VISION_MODEL=google/gemini-2.5-flash

LLM_PROVIDER=openrouter          # openrouter | offline (no key needed; use with JEV_PROVIDER=mock)

# Jev (TypeSafe) via OpenRouter Decisions API
JEV_PROVIDER=jev                 # jev | mock | llm_fallback
JEV_MODEL=typesafe/jev-1.14
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_IMAGE_MODE=image_url         # image_url | assets  (scripts/jev_smoke.py tells you which works)

# Agent behaviour
MAX_PARALLEL_BRANCHES=4
CONF_ACT=0.85
CONF_CHECK=0.60
MAX_STEP_RETRIES=2
STEP_TIMEOUT_S=30
HANDOFF_TIMEOUT_S=600
SCREENSHOT_MAX_WIDTH=1280
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900
HEADLESS=false
DEMO_MODE=false
DOMAIN_BLOCKLIST=

# Server
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
